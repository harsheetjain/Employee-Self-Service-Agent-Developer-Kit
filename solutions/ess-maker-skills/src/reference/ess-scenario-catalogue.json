{
  "schemaVersion": 1,
  "description": "ESS scenario catalogue (data-only). Mirrors the ESS CoCreate Scenario Planner spec: 43 OOB scenarios + E1-E7 extensible, with machine-checkable dependency checks the planner evaluates against the discovered inventory. Keep in sync with the PM spec / ess-catalogue.md.",
  "prioritization": {
    "criteria": [
      "Frequency + Ticket Deflection",
      "Governance Safety",
      "Connector Readiness",
      "Change Management Complexity",
      "Cross-Role Clarity"
    ],
    "principles": [
      "Start high-confidence low-risk, then expand",
      "Avoid heavy per-country logic early",
      "MVP scope drives priority",
      "Readiness checklists are go/no-go gates",
      "Enable a category's reads before its writes"
    ],
    "defaultOrder": [
      "Knowledge retrieval",
      "Ticketing",
      "Employee profile read/write",
      "Agent handoff",
      "Sensitive topics",
      "Multi-language",
      "Mobile access"
    ]
  },
  "roles": [
    "Maker (Copilot Studio)",
    "Experience Manager (in-agent)",
    "Admin"
  ],
